<Window x:Class="GDMENUCardManager.ScrapeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Scrape Artwork and Info" SizeToContent="Height" Width="600" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Closing="Window_Closing">
    <StackPanel Margin="12">
        <TextBlock TextWrapping="Wrap" Margin="0 0 0 10">Finds covers, disc labels and game information online, shrinks the pictures and converts them to the Dreamcast's PVR format. ScreenScraper is asked first (by serial and file name); libretro's thumbnails fill in front covers it does not have. Nothing is written to the SD card until you press Save Changes.</TextBlock>

        <GroupBox Padding="6" Margin="0 0 0 10">
            <GroupBox.Header>
                <CheckBox x:Name="CheckScreenScraper" FontWeight="Bold">ScreenScraper (screenscraper.fr)</CheckBox>
            </GroupBox.Header>
            <StackPanel>
                <Grid Margin="0 0 0 6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center">User name</TextBlock>
                    <TextBox Grid.Column="1" x:Name="TextSsUser"/>
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="10 0 0 0">Password</TextBlock>
                    <PasswordBox Grid.Column="3" x:Name="TextSsPassword"/>
                </Grid>
                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#505050">A free account on screenscraper.fr raises the daily limit and speed. Your password is kept in your user folder (scraper.json), not on the SD card.</TextBlock>
                <Expander Header="Advanced: developer ID" Margin="0 6 0 0">
                    <StackPanel Margin="0 6 0 0">
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#505050" Margin="0 0 0 6">ScreenScraper needs a developer ID for every program that uses it. Leave these empty to use the one built into this program; if there is none, ask for your own on the ScreenScraper forum.</TextBlock>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center">Developer ID</TextBlock>
                            <TextBox Grid.Column="1" x:Name="TextDevId"/>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="10 0 0 0">Password</TextBlock>
                            <PasswordBox Grid.Column="3" x:Name="TextDevPassword"/>
                        </Grid>
                    </StackPanel>
                </Expander>
                <CheckBox x:Name="CheckLibretro" FontWeight="Bold" Margin="0 8 0 0">libretro thumbnails (front covers, no account)</CheckBox>
            </StackPanel>
        </GroupBox>

        <Grid Margin="0 0 0 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock FontWeight="Bold" Margin="0 0 0 4">Get</TextBlock>
                <CheckBox x:Name="CheckFront" Margin="0 2">Front cover (BOX.DAT, ICON.DAT)</CheckBox>
                <CheckBox x:Name="CheckBack" Margin="0 2">Back cover (BACK.DAT)</CheckBox>
                <CheckBox x:Name="CheckDisc" Margin="0 2">Disc label (DISC.DAT)</CheckBox>
                <CheckBox x:Name="CheckInfo" Margin="0 2">Description and info (META.DAT, INFO.DAT)</CheckBox>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock FontWeight="Bold" Margin="0 0 0 4">Games</TextBlock>
                <RadioButton x:Name="RadioMissing" GroupName="Scope" Margin="0 2">Only games missing something</RadioButton>
                <RadioButton x:Name="RadioSelected" GroupName="Scope" Margin="0 2">Selected games</RadioButton>
                <RadioButton x:Name="RadioAll" GroupName="Scope" Margin="0 2">All games</RadioButton>
                <CheckBox x:Name="CheckOverwrite" Margin="0 6 0 0">Replace art and text they already have</CheckBox>
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
            <TextBlock VerticalAlignment="Center" Margin="0 0 8 0">Region</TextBlock>
            <ComboBox x:Name="ComboRegion" Width="130">
                <ComboBoxItem>Disc's own</ComboBoxItem>
                <ComboBoxItem>USA</ComboBoxItem>
                <ComboBoxItem>Europe</ComboBoxItem>
                <ComboBoxItem>Japan</ComboBoxItem>
            </ComboBox>
            <TextBlock VerticalAlignment="Center" Margin="16 0 8 0">Text language</TextBlock>
            <ComboBox x:Name="ComboLanguage" Width="70">
                <ComboBoxItem>en</ComboBoxItem>
                <ComboBoxItem>fr</ComboBoxItem>
                <ComboBoxItem>de</ComboBoxItem>
                <ComboBoxItem>es</ComboBoxItem>
                <ComboBoxItem>it</ComboBoxItem>
                <ComboBoxItem>pt</ComboBoxItem>
            </ComboBox>
        </StackPanel>

        <ProgressBar x:Name="Progress" Height="16" Minimum="0" Maximum="1" Value="0" Margin="0 0 0 6"/>
        <TextBox x:Name="TextLog" Height="190" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontSize="11"
                 VerticalScrollBarVisibility="Auto" Margin="0 0 0 10"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ButtonStart" Padding="16 6" FontWeight="Bold" Click="ButtonStart_Click">Start</Button>
            <Button x:Name="ButtonClose" Padding="16 6" Margin="10 0 0 0" Click="ButtonClose_Click">Close</Button>
        </StackPanel>
    </StackPanel>
</Window>
