<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="400"
        x:Class="GDMENUCardManager.ArtworkWindow"
        Title="{Binding WindowTitle}" Width="420" SizeToContent="Height" CanResize="False" CanMinimize="False"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Serial ID -->
    <TextBlock Grid.Row="0" Text="{Binding Serial}" FontWeight="Bold" Foreground="Black"
               HorizontalAlignment="Center" Margin="0,0,0,10"/>

    <!-- Which picture: the front cover, or the rest of the 3D case -->
    <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,0,8">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
      <RadioButton GroupName="ArtSlot" Content="Front" Tag="Front" IsChecked="True" Click="Slot_Click" Margin="0,0,14,0"
                   ToolTip.Tip="Front cover (BOX.DAT and ICON.DAT)"/>
      <RadioButton GroupName="ArtSlot" Content="Back" Tag="Back" Click="Slot_Click" Margin="0,0,14,0"
                   ToolTip.Tip="Back cover (BACK.DAT)"/>
      <RadioButton GroupName="ArtSlot" Content="Spine" Tag="Spine" Click="Slot_Click" Margin="0,0,14,0"
                   ToolTip.Tip="Spine label (SPINE.DAT)"/>
      <RadioButton GroupName="ArtSlot" Content="Disc" Tag="Disc" Click="Slot_Click"
                   ToolTip.Tip="Disc label: the disc's own (from the GDI) or a picture of your choice"/>
    </StackPanel>
    <!-- The 3D case the menu shows the game in (CASES.INI) -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
      <TextBlock Text="Case:" Foreground="Black" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <ComboBox x:Name="CaseStyleBox" Width="230" SelectionChanged="Case_SelectionChanged" Margin="0,0,12,0"
                ToolTip.Tip="The 3D case the BIOS-style menu shows this game in (CASES.INI)"/>
      <TextBlock Text="Size:" Foreground="Black" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <ComboBox x:Name="CaseSizeBox" Width="210" SelectionChanged="Case_SelectionChanged"
                ToolTip.Tip="A double case for games of two or more discs"/>
    </StackPanel>
    </StackPanel>

<!-- Preview -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Button Click="NavigatePrev_Click"
              IsEnabled="{Binding CanNavigatePrev}"
              ToolTip.Tip="Show previous game's artwork"
              VerticalAlignment="Center" Width="30" Height="40" Padding="0" Margin="0,0,40,0">
        <Path Data="M 10,0 L 0,8 L 10,16" Stroke="Black" StrokeThickness="2"
              HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Button>

      <Border BorderBrush="Gray" BorderThickness="1"
              Width="260" Height="260" VerticalAlignment="Center" Margin="0,0,40,0">
        <Grid>
          <TextBlock Text="{Binding EmptyText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsVisible="{Binding !HasPreviewImage}"/>
          <Image Source="{Binding PreviewImage}" Stretch="Uniform"
                 IsVisible="{Binding HasPreviewImage}"/>
        </Grid>
      </Border>

      <Button Click="NavigateNext_Click"
              IsEnabled="{Binding CanNavigateNext}"
              ToolTip.Tip="Show next game's artwork"
              VerticalAlignment="Center" Width="30" Height="40" Padding="0">
        <Path Data="M 0,0 L 10,8 L 0,16" Stroke="Black" StrokeThickness="2"
              HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Button>
    </StackPanel>

    <!-- Info Label -->
    <StackPanel Grid.Row="3" Margin="0,10,0,0">
      <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Foreground="Black" Text="{Binding SlotHint}"/>
      <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="Black"
                 Text="Artwork changes aren't written to DAT files until clicking Save Changes in the main window."/>
    </StackPanel>

    <!-- Buttons -->
    <StackPanel x:Name="ButtonRow" Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
      <Button Content="Browse for Image" Click="BrowseImage_Click" Margin="0,0,10,0" Padding="15,8"
              ToolTip.Tip="Choose a PNG, JPG, or BMP file to use as artwork for this game"/>
      <Button Content="Import From Disc" Click="ImportFromDisc_Click" Margin="0,0,10,0" Padding="15,8"
              IsEnabled="{Binding CanImportFromDisc}"
              ToolTip.ShowOnDisabled="True"
              ToolTip.Tip="{Binding ImportFromDiscTooltip}"/>
      <Button Content="Delete Entry" Click="DeleteEntry_Click" Margin="0,0,10,0" Padding="15,8"
              IsEnabled="{Binding CanDelete}"
              ToolTip.Tip="Remove this game's artwork and metadata from the DATs"/>
      <Button Content="Save" Click="Apply_Click" Padding="15,8"
              IsEnabled="{Binding HasUnsavedChanges}"
              ToolTip.Tip="Stage artwork changes for this game (DAT files aren't written until you click Save Changes in the main window)"/>
    </StackPanel>
  </Grid>
</Window>
