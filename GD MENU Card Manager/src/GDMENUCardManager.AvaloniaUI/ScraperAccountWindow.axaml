<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="360"
        x:Class="GDMENUCardManager.ScraperAccountWindow"
        Title="ScreenScraper Account" Width="460" SizeToContent="Height" CanResize="False" CanMinimize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="12" Spacing="8">
    <TextBlock TextWrapping="Wrap" Foreground="Black">Your screenscraper.fr account, used by Scrape. Logging in gives you more requests a day and faster answers. The account is free.</TextBlock>
    <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto" Margin="0 4 0 0">
      <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Foreground="Black">User name</TextBlock>
      <TextBox Grid.Row="0" Grid.Column="1" x:Name="TextUser"/>
      <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0 6 0 0" Foreground="Black">Password</TextBlock>
      <TextBox Grid.Row="1" Grid.Column="1" x:Name="TextPassword" PasswordChar="*" Margin="0 6 0 0"/>
      <CheckBox Grid.Row="2" Grid.Column="1" x:Name="CheckShowPassword" Margin="0 4 0 0" Click="CheckShowPassword_Click">Show password</CheckBox>
    </Grid>
    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#505050">Kept in your user folder (scraper.json, not encrypted), never on the SD card.</TextBlock>
    <Button HorizontalAlignment="Left" Padding="10 4" Click="ButtonCreateAccount_Click">Create an account on screenscraper.fr</Button>

    <Expander Header="Advanced: developer ID">
      <StackPanel Spacing="6" Margin="0 6 0 0">
        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#505050">Every program that uses ScreenScraper needs a developer ID. Leave these empty to use the one built into this program; if there is none, ask for your own on the ScreenScraper forum.</TextBlock>
        <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Foreground="Black">Developer ID</TextBlock>
          <TextBox Grid.Row="0" Grid.Column="1" x:Name="TextDevId"/>
          <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0 6 0 0" Foreground="Black">Password</TextBlock>
          <TextBox Grid.Row="1" Grid.Column="1" x:Name="TextDevPassword" PasswordChar="*" Margin="0 6 0 0"/>
        </Grid>
      </StackPanel>
    </Expander>

    <Border BorderBrush="#C0C0C0" BorderThickness="1" Padding="8" MinHeight="40">
      <TextBlock x:Name="TextStatus" TextWrapping="Wrap" Foreground="Black">Not checked yet.</TextBlock>
    </Border>

    <Grid ColumnDefinitions="Auto,*,Auto">
      <Button Grid.Column="0" x:Name="ButtonTest" Padding="12 6" Click="ButtonTest_Click">Test login</Button>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
        <Button x:Name="ButtonSave" Padding="16 6" FontWeight="Bold" Click="ButtonSave_Click">Save</Button>
        <Button Padding="16 6" Click="ButtonCancel_Click">Cancel</Button>
      </StackPanel>
    </Grid>
  </StackPanel>
</Window>
